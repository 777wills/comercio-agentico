# Copia este archivo como .env y completa tus claves. El .env nunca se versiona (repositorio público).

# Anthropic (Claude Haiku 5.5, Sonnet 5.5, Opus 5.5) — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter (DeepSeek V4.1 Flash, DeepSeek V4 Pro, Kimi K3.1 Pro) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TypeSafe AI (Jev, modelo de decisión; comparación con el clasificador local de C2, D80) — https://console.typesafe.ai/keys
# Usar solo la API oficial https://api.typesafe.ai
TYPESAFE_API_KEY=

# Modelo por defecto para desarrollo (el más barato que funcione; ver docs/DECISIONES.md, D33)
MODELO_DESARROLLO=deepseek/deepseek-v4.1-flash

# Tope de gasto por tarea en US$ (protege los créditos ante bucles del agente)
COSTO_MAXIMO_POR_TAREA_USD=0.50
