# Secretos
.env
.env.*
!.env.example

# Material del curso, entregables y contexto privado (el repositorio es público)
privado/

# Red de seguridad: documentos de oficina fuera de privado/ tampoco se versionan
*.docx
*.pptx
*.pdf
*.xlsx
*.csv
Tema_*.html
contexto_claude/

# Copias congeladas de tiendas reales (obra de terceros); solo se versiona el manifiesto
corpus/a_real/copias/
# Variantes del corpus B con cargas plantadas: se regeneran desde ataques/cargas.yaml (D95).
corpus/b_ataques/
resultados/ataques/*_simulado/

# Python y herramientas
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.ipynb_checkpoints/

# Artefactos pesados o locales
resultados/cache/
*.sqlite
*.db
.crawl4ai/
.DS_Store
.vscode/
.idea/

# Excepción: PDF generados del corpus B sintético sí se versionan
!corpus/b_sintetico/**/*.pdf

# Corridas: se versiona solo la copia comprimida (.jsonl.gz); el .jsonl sirve para reanudar.
resultados/corridas/*.jsonl
resultados/corridas/*_simulado.jsonl.gz
resultados/ataques/*.jsonl
resultados/ataques/*_simulado.jsonl.gz
resultados/ataques/*_simulado_m5.*
# Salidas del agente simulado (se regeneran con make arnes-simulado)
resultados/informes/*_simulado/

# Tiendas del corpus A reconstruidas: se generan con `make corpus-a` desde los hechos versionados
corpus/a_real/sitio/
